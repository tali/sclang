// RUN: sclang --opt --emit=jit %s 2>&1 | FileCheck %s
// CHECK-NOT: failed

// Message form: unchanged output, one line of text.
// CHECK: hello message
// Value form: `line N: <expr text> = <value>` via the runtime C ABI.
// CHECK: line {{[0-9]+}}: x = 42
// CHECK: line {{[0-9]+}}: x + 1 = 43
// CHECK: line {{[0-9]+}}: r = 1.5
// CHECK: line {{[0-9]+}}: b = 1
function OB1 : int
var_temp
  x : int;
  r : real;
  b : bool;
end_var
begin
  x := 42;
  r := 1.5;
  b := true;
  // DEBUG PRINT hello message
  // DEBUG PRINT x;
  // DEBUG PRINT x + 1;
  // DEBUG PRINT r;
  // DEBUG PRINT b;
  OB1 := 0;
end_function
function _mlir_ciface_OB1 : void
begin
  OB1();
end_function
