// RUN: sclang --test-builtins --opt --emit=jit %s 2>&1 | FileCheck %s
// CHECK-NOT: failed

// CHECK: start OB1
// CHECK: two
// CHECK: exit OB1
function OB1 : int
var
  x : int;
end_var
begin
  x := 2;
  case x of
    1: __DEBUG_PRINT('one');
    2: __DEBUG_PRINT('two');
    3: __DEBUG_PRINT('three');
  else
    __DEBUG_PRINT('other');
  end_case;
end_function

function _mlir_ciface_OB1 : void
begin
  __DEBUG_PRINT('start OB1');
  OB1();
  __DEBUG_PRINT('exit OB1');
end_function
