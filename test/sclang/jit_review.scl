// RUN: sclang --test-builtins --opt --emit=jit %s 2>&1 | FileCheck %s
// CHECK-NOT: failed

// CHECK: start
// CHECK: fb ok
// CHECK: loop ok
// CHECK: str ok
// CHECK: range ok
// CHECK: done
function_block fb1
var_output
  a : array[1..3] of int;
  b : bool;
end_var
var_input
  i : int;
end_var
var
  state : int := 7;
end_var
begin
  a[i] := i * 10;
  b := state > 0;
end_function_block
data_block db1
  fb1
end_data_block
function OB1 : int
var_temp
  i : int;
  sum : int;
  s : string[8];
end_var
begin
  "db1".i := 2;
  fb1."db1"();
  if "db1".a[2] = 20 and "db1".b then
    __DEBUG_PRINT('fb ok');
  end_if;
  sum := 0;
  for i := 1 to 10 do
    if i mod 2 = 0 then
      continue;
    end_if;
    if i > 7 then
      exit;
    end_if;
    sum := sum + i;
  end_for;
  if sum = 16 then
    __DEBUG_PRINT('loop ok');
  end_if;
  s := 'hi';
  __DEBUG_PRINT('str ok');
  case sum of
    10..20:
      __DEBUG_PRINT('range ok');
  else
    __DEBUG_PRINT('range bad');
  end_case;
  OB1 := sum;
end_function
function _mlir_ciface_OB1 : void
begin
  __DEBUG_PRINT('start');
  OB1();
  __DEBUG_PRINT('done');
end_function
