// RUN: sclang --opt --emit=llvm %s 2>&1 | FileCheck %s

// CHECK: define i16 @abs(i16 [[IN:%[a-z0-9_.]+]]) local_unnamed_addr #0
// CHECK:   [[RET:%[a-z0-9_.]+]] = tail call i16 @llvm.abs.i16(i16 [[IN]], i1 false)
// CHECK:   ret i16 [[RET]]
// CHECK: }
function abs : int

var_input
 in : int;
end_var;

begin

  if in < int#0 then

    abs := -in;

  elsif in > int#0 then

    abs := in;

  else

    abs := int#0;

  end_if;

end_function
