// RUN: sclang --opt --emit=llvm %s 2>&1 | FileCheck %s

// LLVM 23 emits range attributes and unnamed args.
// CHECK: define {{.*}}i16 @abs(i16 %{{[0-9]+}}) local_unnamed_addr #{{[0-9]+}} {
// CHECK:   %{{[0-9.]+}} = tail call i16 @llvm.abs.i16(i16 %{{[0-9]+}}, i1 false)
// CHECK:   ret i16 %{{[0-9.]+}}
// CHECK: }
function abs : int

var_input
 in : int;
end_var;

begin

  if in < int#0 then

    abs := -in;

  elsif in > int#0 then

    abs := in;

  else

    abs := int#0;

  end_if;

end_function
