// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// Nested struct member access: s.p.x resolves to a single byte view at the
// cumulative offset (p at 0, x at 0 within point) of the root buffer.
// CHECK-LABEL: func.func @f
// CHECK:         memref.alloca() : memref<6xi8>
// CHECK:         memref.copy
// CHECK:         memref.reinterpret_cast {{%[a-z_0-9]+}} to offset: [0], sizes: [2]
// CHECK:         memref.reinterpret_cast {{%[a-z_0-9]+}} to offset: [4], sizes: [2]
type point
  struct
    x : int;
    y : int;
  end_struct
end_type
type shape
  struct
    p : point;
    n : int;
  end_struct
end_type
function f : int
var_input
  s : shape;
end_var
begin
  f := s.p.x + s.n;
end_function
