// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// A string variable is a char buffer; assigning a literal stores the bytes
// (zero-padded) one at a time.
// CHECK-LABEL: func.func @f
// CHECK:         %[[S:[a-z_0-9]+]] = memref.alloca() : memref<4xi8>
// CHECK:         memref.reinterpret_cast %{{[a-z_0-9]+}} to offset: [0]
// CHECK:         memref.store %c104_i8
// CHECK:         memref.store %c105_i8
// CHECK:         memref.store %c0_i8
// CHECK:         memref.store %c0_i8
// CHECK:         memref.load {{.*}} : memref<1xi8, strided<[1], offset: 1>>
function f : int
var_temp
  s : string[4];
end_var
begin
  s := 'hi';
  f := s[1];
end_function
