// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// CHECK-LABEL: func.func @arr
// CHECK:         %[[A:[a-z_0-9]+]] = memref.alloca() : memref<3xi16>
// CHECK:         %[[EL:[a-z_0-9]+]] = memref.reinterpret_cast %[[A]] to offset: [%c1]
// CHECK:         memref.store %c42_i16, %[[EL]][] : memref<i16, strided<[], offset: ?>>
function arr : int
var
  a : array[1..3] of int;
  i : int;
end_var
begin
  a[2] := 42;
  i := a[2];
end_function
