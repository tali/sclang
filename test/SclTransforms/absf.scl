// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// CHECK:      func.func @abs(%arg0: f32) -> f32
function abs : real

var_input
 in : real;
end_var;

begin

// CHECK: [[C0:%[a-z0-9]+]] = arith.constant 0.000000e+00 : f32
// CHECK: memref.store %arg0, [[INVAR:%[a-z_0-9]+]][] : memref<f32, strided<[]>>

// CHECK: [[IN:%[0-9]+]] = memref.load [[INVAR]]
// CHECK: [[LT:%[0-9]+]] = arith.cmpf ult, [[IN]], [[C0]] fastmath<contract>
// CHECK: cf.cond_br [[LT]]
  if in < 0.0 then

// CHECK:   [[IN:%[0-9]+]] = memref.load [[INVAR]]
// CHECK:   [[NEG:%[0-9]+]] = arith.negf [[IN]] fastmath<contract> : f32
// CHECK:   memref.store [[NEG]], [[ABS:%[a-z_0-9]+]][] : memref<f32, strided<[]>>
    abs := -in;

// CHECK:   [[IN:%[0-9]+]] = memref.load [[INVAR]]
// CHECK:   [[GT:%[0-9]+]] = arith.cmpf ugt, [[IN]], [[C0]] fastmath<contract>
// CHECK: cf.cond_br [[GT]]
  elsif in > 0.0 then

// CHECK:     [[IN:%[0-9]+]] = memref.load [[INVAR]]
// CHECK:     memref.store [[IN]], [[ABS]][] : memref<f32, strided<[]>>
    abs := in;

  else

// CHECK: memref.store [[C0]], [[ABS]][] : memref<f32, strided<[]>>
    abs := 0.0;

  end_if;

// CHECK: [[RET:%[0-9]+]] = memref.load [[ABS]][] : memref<f32, strided<[]>>
// CHECK: return [[RET]]
end_function
