// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// Boolean literals are typed i1, and a bool variable can be a loop condition.
// CHECK-LABEL: func.func @f
// CHECK:         arith.constant false
// CHECK:         cf.cond_br
// CHECK:         memref.store %{{.*}}, {{.*}} : memref<i1, strided<[]>>
function f : int
var_temp
  b : bool;
  i : int;
end_var
begin
  b := true;
  i := 0;
  while b do
    i := i + 1;
    if i > 3 then
      b := false;
    end_if;
  end_while;
  f := i;
end_function
