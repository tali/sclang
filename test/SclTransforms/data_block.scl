// RUN: sclang-gen --emit=mlir-std %s | FileCheck %s

// CHECK: memref.global @db1 : memref<i16, strided<[], offset: ?>>
data_block db1 int
end_data_block

// CHECK-LABEL: func.func @fc1
// CHECK:         %[[G:[0-9]+]] = memref.get_global @db1 : memref<i16, strided<[], offset: ?>>
function fc1 : int
begin
  fc1 := "db1";
end_function
