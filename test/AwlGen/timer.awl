// RUN: sclang-gen -x awl --emit=mlir %s | FileCheck %s
// SPEC[AWL] Siemens AWL manual timer instructions (SP/SE/SS/SV/SI/SD) + runtime
// Timer/counter instructions: S5T# literal encodes to (base<<12)|BCD
// (S5T#1S = 0x2001), SS -> awl.timer_start, ZV/S -> awl.counter,
// `U T1.0` is the status bit (width 1), `L T1` the value (width 16).
// CHECK-LABEL: awl.block "OB1"
// CHECK: %{{.*}} = awl.const 256 : i32 -> i32
// CHECK: awl.direct T, 0, 0, 0, 16 : !scl.direct<T, 0, 0, 0, 16>
// CHECK: awl.timer_start 2, %{{.*}} : i32, %{{.*}} : !scl.direct<T, 0, 0, 0, 16>
// CHECK: awl.direct T, 0, 1, 0, 1 : !scl.direct<T, 0, 1, 0, 1>
// CHECK: awl.rlo_and %{{.*}}, %{{.*}} : i1, !scl.direct<T, 0, 1, 0, 1> -> i1
// CHECK: awl.load %{{.*}} : !scl.direct<T, 0, 1, 0, 16> -> i16
// CHECK: awl.counter 2, %{{.*}} : i32, %{{.*}} : !scl.direct<C, 0, 5, 0, 16>
// CHECK: awl.counter 0, %{{.*}} : i16, %{{.*}} : !scl.direct<C, 0, 5, 0, 16>
OB 1
  L S5T#1S
  SS T0
  U T1.0
  L T1
  T MW10
  L 3
  S Z5
  ZV Z5
  BE
