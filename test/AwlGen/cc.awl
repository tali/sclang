// RUN: sclang-gen -x awl --emit=mlir %s | FileCheck %s
// RUN: sclang-gen -x awl --emit=mlir-std %s | FileCheck %s --check-prefix=STD
// RUN: sclang-gen -x awl --emit=awl %s | sclang-gen -x awl --emit=awl - | FileCheck %s --check-prefix=RT
// CC (conditional call, RLO = 1): parses to awl.call with an rlo operand;
// lowering splits the block and guards the call with cf.cond_br on the rlo.
// Comparisons use M-area loads so the canonicalizer cannot fold the rlo.
// CHECK: awl.call {instdb} @FB1, rlo %{{.*}} : i1, db 2
// CHECK: awl.call {instdb} @FB1, rlo %{{.*}} : i1, db 2
// STD: cf.cond_br %{{.*}}, ^bb{{[0-9]+}}, ^bb{{[0-9]+}}
// STD: call @FB1(%c2_i32) : (i32) -> ()
// STD: cf.cond_br %{{.*}}, ^bb{{[0-9]+}}, ^bb{{[0-9]+}}
// STD: call @FB1(%c2_i32) : (i32) -> ()
// RT-LABEL: {{^}}OB 1
// RT: CC FB 1, DB 2
// RT: CC FB 1, DB 2
// RT-LABEL: {{^}}FB 1
// RT: L DB.DBW0
// RT: T DB.DBW0
OB 1
  S M0.0
  L MB0
  L 1
  ==I
  CC FB 1, DB 2
  L MB1
  L 1
  ==I
  CC FB 1, DB 2
  BE
FB 1
  L DB.DBW0
  L 1
  +I
  T DB.DBW0
  BE
