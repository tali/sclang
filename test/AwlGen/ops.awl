// RUN: sclang-gen -x awl --emit=mlir %s | FileCheck %s
// AWL frontend codegen: accumulator stack, RLO, labels/jumps (ADR 003).
// CHECK-LABEL: awl.block "OB1"
// CHECK: %{{.*}} = awl.direct M, 0, 10, 0, 16 : !scl.direct<M, 0, 10, 0, 16>
// CHECK: %{{.*}} = awl.load %{{.*}} : !scl.direct<M, 0, 10, 0, 16> -> i16
// CHECK: %{{.*}} = awl.load %{{.*}} : !scl.direct<M, 0, 12, 0, 16> -> i16
// CHECK: %{{.*}} = awl.add %{{.*}} : i16, %{{.*}} : i16 -> i16
// CHECK: awl.store %{{.*}}, %{{.*}} : i16, !scl.direct<M, 0, 14, 0, 16>
// CHECK: %{{.*}} = awl.const 5 : i16 -> i16
// CHECK: %{{.*}} = awl.const 3 : i16 -> i16
// CHECK: %{{.*}} = awl.cmpeq %{{.*}} : i16, %{{.*}} : i16 -> i1
// CHECK: awl.jump_if %{{.*}}, "SKIP" : i1
// CHECK: awl.set %{{.*}} : !scl.direct<Q, 0, 1, 0, 1> -> i1
// CHECK: awl.label "SKIP"
// CHECK: %{{.*}} = awl.cmpgt %{{.*}} : i16, %{{.*}} : i16 -> i1
// CHECK: awl.jump_if %{{.*}}, "BIG" : i1
// CHECK: awl.reset %{{.*}} : !scl.direct<Q, 0, 1, 0, 1> -> i1
// CHECK: awl.label "BIG"
// CHECK: %{{.*}} = awl.rlo_and %{{.*}}, %{{.*}} : i1, !scl.direct<I, 0, 0, 0, 1> -> i1
// CHECK: awl.assign %{{.*}}, %{{.*}} : i1, !scl.direct<Q, 0, 2, 0, 1>
// CHECK: awl.be
// CHECK-LABEL: awl.block "_mlir_ciface_OB1"
// CHECK: awl.call @OB1
// CHECK: awl.be
OB 1
  L MW 10
  L MW 12
  +I
  T MW 14
  L 5
  L 3
  ==I
  SPB skip
  S A 1.0
skip:
  L MW 14
  L 8
  >I
  SPB big
  R A 1.0
big:
  U E 0.0
  = A 2.0
  BE
