// RUN: sclang-gen -x awl --emit=mlir %s | FileCheck %s
// RUN: sclang-gen -x awl --emit=mlir-std %s | FileCheck %s --check-prefix=STD
// RUN: sclang-gen -x awl --emit=awl %s | sclang-gen -x awl --emit=awl - | FileCheck %s --check-prefix=RT
// CALL FB n, DB m (docs/design/awl-frontend.md): the call carries the
// instance DB number; inside the FB, bare DB operands (db=0) mean the
// instance DB and lower to scl_rt_read/write on the func argument.
// CHECK-LABEL: awl.block "OB1"
// CHECK: awl.call @FB1(), db 2 : () -> ()
// CHECK: awl.direct DB, 2, 0, 0, 16 : !scl.direct<DB, 2, 0, 0, 16>
// CHECK-LABEL: awl.block "FB1"
// CHECK: awl.direct DB, 0, 0, 0, 16 : !scl.direct<DB, 0, 0, 0, 16>
// STD-LABEL: func.func @OB1()
// STD: call @FB1(%c2_i32) : (i32) -> ()
// STD: call @scl_rt_read(%c68_i8, %c2_i32, %c0_i32, %c2_i8) : (i8, i32, i32, i8) -> i64
// STD-LABEL: func.func @FB1(%arg0: i32)
// STD: call @scl_rt_read(%c68_i8, %arg0, %c0_i32, %c2_i8) : (i8, i32, i32, i8) -> i64
// STD: call @scl_rt_write(%c68_i8, %arg0, %c0_i32, %c2_i8, %{{.*}}) : (i8, i32, i32, i8, i64) -> ()
// RT-LABEL: {{^}}OB 1
// RT: CALL FB 1, DB 2
// RT-LABEL: {{^}}FB 1
// RT: L DB.DBW0
// RT: T DB.DBW0
OB 1
  CALL FB 1, DB 2
  CALL FB 1, DB 2
  L DB2.DBW0
  T MW0
  BE
FB 1
  L DB.DBW0
  L 1
  +I
  T DB.DBW0
  BE
