// RUN: sclang-gen --emit=mlir %s | sclang-gen -x mlir --emit=mlir --opt | FileCheck %s

// CHECK-LABEL: scl.function_block @if_then
function_block if_then


// CHECK: scl.var input "a" : !scl.bool
var_input
  a : bool;
end_var

// CHECK: scl.var output "b" : !scl.int
var_output
  b : int;
end_var

begin

// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c1 : !scl.int
  b := 1;

// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @a from %arg0
// CHECK: %{{[0-9]+}} = scl.load %{{[a-z0-9_]+}} : !scl.address<!scl.char> : !scl.bool
// CHECK: scl.if %0 : !scl.bool {
  if a then
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c2 : !scl.int
    b := 2;
  end_if;
// CHECK: } else  {
// CHECK: }

end_function_block


// CHECK-LABEL: scl.function_block @if_then_else
function_block if_then_else

// CHECK: scl.var input "a" : !scl.bool
var_input
  a : bool;
end_var

// CHECK: scl.var output "b" : !scl.int
var_output
  b : int;
end_var

begin

// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @a from %arg0
// CHECK: %{{[0-9]+}} = scl.load %{{[a-z0-9_]+}} : !scl.address<!scl.char> : !scl.bool
// CHECK: scl.if %0 : !scl.bool {
  if a then
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c1 : !scl.int
    b := 1;
// CHECK: } else  {
  else
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c2 : !scl.int
    b := 2;
// CHECK: }
  end_if;
end_function_block


// CHECK-LABEL: scl.function_block @if_then_elsif
function_block if_then_elsif

// CHECK: scl.var input "a1" : !scl.bool
// CHECK: scl.var input "a2" : !scl.bool
var_input
  a1 : bool;
  a2 : bool;
end_var

// CHECK: scl.var output "b" : !scl.int
var_output
  b : int;
end_var

begin

// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @a1 from %arg0
// CHECK: %{{[0-9]+}} = scl.load %{{[a-z0-9_]+}} : !scl.address<!scl.char> : !scl.bool
// CHECK: scl.if %0 : !scl.bool {
  if a1 then
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c1 : !scl.int
    b := 1;
// CHECK: } else  {
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @a2 from %arg0
// CHECK: %{{[0-9]+}} = scl.load %{{[a-z0-9_]+}} : !scl.address<!scl.char> : !scl.bool
// CHECK: scl.if %1 : !scl.bool  {
  elsif a2 then
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c2 : !scl.int
    b := 2;
// CHECK: } else  {
  else
// CHECK: %{{[a-z0-9_]+}} = scl.getvariable @b from %arg0
// CHECK: scl.store %{{[a-z0-9_]+}} : !scl.address<!scl.char> = %c3 : !scl.int
    b := 3;
// CHECK: }
  end_if;

end_function_block
