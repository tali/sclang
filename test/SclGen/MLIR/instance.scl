// RUN: sclang-gen --emit=mlir %s --opt | FileCheck %s

// CHECK-LABEL: scl.function_block @fb1
// CHECK: (%arg0: !scl.address<!scl.idb<fb1>>)
function_block fb1

// CHECK: scl.var input "in" : !scl.int
var_input
  in : int;
end_var;

// CHECK: scl.var output "out" : !scl.int
var_output
  out : int;
end_var

// CHECK: scl.var "state" : !scl.int
var
  state : int := 0;
end_var

begin
// CHECK: %out = scl.getvariable @out from %arg0 : !scl.address<!scl.idb<fb1>> -> !scl.address<!scl.char>
// CHECK: %state = scl.getvariable @state from %arg0 : !scl.address<!scl.idb<fb1>> -> !scl.address<!scl.char>
// CHECK: %0 = scl.load %state : !scl.address<!scl.char> : !scl.int
// CHECK: scl.store %out : !scl.address<!scl.char> = %0 : !scl.int
  out := state;

// CHECK: %in{{[a-z0-9_]*}} = scl.getvariable @in from %arg0 : !scl.address<!scl.idb<fb1>> -> !scl.address<!scl.char>
// CHECK: %{{[0-9]+}} = scl.load %in{{[a-z0-9_]*}} : !scl.address<!scl.char> : !scl.int
// CHECK: scl.store %state{{[a-z0-9_]*}} : !scl.address<!scl.char> = %{{[0-9]+}} : !scl.int
  state := in;

// CHECK: scl.return
end_function_block


///////////////////


// CHECK-LABEL: scl.db "db1"
data_block db1

// CHECK: !scl.idb<fb1>
  fb1

begin
end_data_block


///////////////////


// CHECK: scl.function @fc1() -> !scl.int {
function fc1 : int

begin


// CHECK: %db1{{[a-z0-9_]*}} = scl.getglobal @db1 : !scl.address<!scl.idb<fb1>>
// CHECK: %in{{[a-z0-9_]*}} = scl.getvariable @in from %db1{{[a-z0-9_]*}} : !scl.address<!scl.idb<fb1>> -> !scl.address<!scl.char>
// CHECK: scl.store %in{{[a-z0-9_]*}} : !scl.address<!scl.char> = %c1 : !scl.int
  "db1".in := 1;

// CHECK: scl.call.fb @fb1(%db1{{[a-z0-9_]*}} : !scl.address<!scl.idb<fb1>>)
  fb1."db1"();

// CHECK: %out{{[a-z0-9_]*}} = scl.getvariable @out from %db1{{[a-z0-9_]*}} : !scl.address<!scl.idb<fb1>> -> !scl.address<!scl.char>
// CHECK: %{{[0-9]+}} = scl.load %out{{[a-z0-9_]*}} : !scl.address<!scl.char>
// CHECK: scl.store %fc1 : !scl.address<!scl.int> = %{{[0-9]+}} : !scl.int
  fc1 := "db1".out;

end_function
